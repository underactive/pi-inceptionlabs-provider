{
  "name": "@underactive/pi-inceptionlabs-provider",
  "version": "0.1.1",
  "type": "module",
  "description": "Inception Mercury 3 provider for Pi, with in-transcript diffusion playback",
  "author": "Eric Sison",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underactive/pi-inceptionlabs-provider.git"
  },
  "homepage": "https://github.com/underactive/pi-inceptionlabs-provider#readme",
  "bugs": {
    "url": "https://github.com/underactive/pi-inceptionlabs-provider/issues"
  },
  "keywords": ["pi-package", "pi", "pi-extension", "provider", "inception", "mercury", "diffusion", "llm"],
  "pi": { "extensions": ["./index.js"] },
  "files": ["index.js", "diffusion.js", "README.md", "LICENSE", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.19" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/** test/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.4.0"
  }
}
